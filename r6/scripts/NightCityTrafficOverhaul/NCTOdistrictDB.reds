public func DistrictDbGameVersion(registrySize: Int32) -> String {
    if registrySize == 924 { return "2.5"; }
    if registrySize == 922 { return "2.31"; }
    return "";
}

public func DistrictDbForRegistrySize(registrySize: Int32) -> array<String> {
    if registrySize == 924 { return DISTRICT_DB_25(); }
    if registrySize == 922 { return DISTRICT_DB_231(); }
    let none: array<String>;
    return none;
}
